    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.12.0",
    "postcss": "8.4.47",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.10",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.2.2"
