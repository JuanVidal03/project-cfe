    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "7.53.0",
    "react-icons": "5.3.0",
    "react-router-dom": "6.27.0",
    "react-toastify": "11.0.5"
